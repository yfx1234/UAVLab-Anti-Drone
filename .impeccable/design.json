      "html": "<label class=\"ds-label\" for=\"ds-note\">备注</label><input class=\"ds-input\" id=\"ds-note\" placeholder=\"采集备注\" maxlength=\"100\">",
      "css": ".ds-label{display:block;color:var(--muted,#626266);font:400 12px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;margin:12px 0 6px}.ds-input{width:100%;min-width:0;min-height:36px;background:var(--paper,#fff);color:var(--ink,#252526);font:400 14px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;border:1px solid var(--control-line,#c8c8c6);border-radius:7px;padding:7px 10px;caret-color:var(--blue,#303033)}.ds-input::placeholder{color:#707074;opacity:1}.ds-input:focus-visible{outline:2px solid #788795;outline-offset:3px}"
    },
    {
