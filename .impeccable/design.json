      "css": ".ds-quiet{display:inline-flex;align-items:center;justify-content:center;gap:7px;font:500 13px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;min-height:36px;border:1px solid var(--control-line,#c8c8c6);border-radius:7px;padding:7px 8px;cursor:pointer;transition:background .15s ease-out,border-color .15s ease-out}.ds-quiet:focus-visible{outline:2px solid #788795;outline-offset:3px}.ds-quiet:disabled{color:#858589;background:#f2f2f0;border-color:#e0e0de;cursor:default}@media(prefers-reduced-motion:reduce){.ds-quiet{transition:none}}.ds-quiet{font-size:12px;min-height:30px;padding:5px 7px;background:none;color:var(--ink,#252526);border-color:transparent}.ds-quiet:hover:not(:disabled){background:#ebebe9;border-color:transparent}.ds-quiet:active:not(:disabled){background:#ebebe9}.ds-quiet:disabled{background:none;border-color:transparent}.ds-icon{width:18px;height:18px;stroke:currentColor;stroke-width:1.6;fill:none;stroke-linecap:round;stroke-linejoin:round;flex:none}"
