      "html": "<span class=\"ds-status\">板子未连接</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;font:400 12px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;color:var(--muted,#626266)}.ds-status::before{content:\"\";height:6px;width:6px;border-radius:50%;background:#9b9b9e;flex:none}.ds-status.ds-good{color:var(--green,#216d50)}.ds-status.ds-good::before{background:#3a9876}.ds-status.ds-bad{color:var(--red,#ac3e43)}.ds-status.ds-bad::before{background:#cf6670}.ds-status.ds-warn{color:var(--amber,#856020)}.ds-status.ds-warn::before{background:#ad8436}"
    },
    {
