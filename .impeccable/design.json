      "kind": "card",
      "refersTo": "section",
      "description": "细边界的功能容器；没有通用浮起卡片阴影。",
      "html": "<section class=\"ds-section\"><div class=\"ds-section-head\"><h2 class=\"ds-heading\">本机视频</h2></div><div class=\"ds-media-select\"><select class=\"ds-select\" aria-label=\"选择本机视频\"><option>暂无下载视频</option></select></div></section>",
      "css": ".ds-section{background:var(--paper,#fff);color:var(--ink,#252526);border:1px solid var(--line,#dededc);border-radius:10px;overflow:hidden;font:400 14px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Microsoft YaHei\",sans-serif}.ds-section-head{display:flex;align-items:center;min-height:58px;padding:12px 18px;border-bottom:1px solid var(--line,#dededc)}.ds-heading{margin:0;font-size:17px;font-weight:600;letter-spacing:-.02em}.ds-media-select{padding:12px 18px;background:var(--rail,#fafaf9);border-bottom:1px solid var(--line,#dededc)}.ds-select{width:100%;min-width:0;min-height:36px;background:var(--paper,#fff);color:var(--ink,#252526);font:400 12px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;padding:7px 10px;border:1px solid var(--control-line,#c8c8c6);border-radius:7px;cursor:pointer}.ds-select:focus-visible{outline:2px solid #788795;outline-offset:3px}"
