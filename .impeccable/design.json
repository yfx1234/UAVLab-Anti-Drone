      "name": "Primary control",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "控制栏主要操作；石墨填充。",
      "html": "<button class=\"ds-primary\" type=\"button\">启动相机</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;font:500 13px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;min-height:36px;border:1px solid var(--control-line,#c8c8c6);border-radius:7px;padding:7px 8px;cursor:pointer;transition:background .15s ease-out,border-color .15s ease-out}.ds-primary:focus-visible{outline:2px solid #788795;outline-offset:3px}.ds-primary:disabled{color:#858589;background:#f2f2f0;border-color:#e0e0de;cursor:default}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}.ds-primary{background:var(--blue,#303033);color:#fff;border-color:var(--blue,#303033)}.ds-primary:hover:not(:disabled){background:#171719;border-color:#171719}.ds-primary:active:not(:disabled){background:#171719}"
    },
    {
      "name": "Secondary control",
