      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:7px;font:500 13px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;min-height:36px;border:1px solid var(--control-line,#c8c8c6);border-radius:7px;padding:7px 8px;cursor:pointer;transition:background .15s ease-out,border-color .15s ease-out}.ds-secondary:focus-visible{outline:2px solid #788795;outline-offset:3px}.ds-secondary:disabled{color:#858589;background:#f2f2f0;border-color:#e0e0de;cursor:default}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}.ds-secondary{background:var(--paper,#fff);color:var(--ink,#252526)}.ds-secondary:hover:not(:disabled){background:#f0f0ee;border-color:#a6a6a4}.ds-secondary:active:not(:disabled){background:#e8e8e6}"
    },
    {
      "name": "Danger control",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "停止相机；红字与边界而非大片警报色。",
      "html": "<button class=\"ds-danger\" type=\"button\">停止相机</button>",
      "css": ".ds-danger{display:inline-flex;align-items:center;justify-content:center;gap:7px;font:500 13px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;min-height:36px;border:1px solid var(--control-line,#c8c8c6);border-radius:7px;padding:7px 8px;cursor:pointer;transition:background .15s ease-out,border-color .15s ease-out}.ds-danger:focus-visible{outline:2px solid #788795;outline-offset:3px}.ds-danger:disabled{color:#858589;background:#f2f2f0;border-color:#e0e0de;cursor:default}@media(prefers-reduced-motion:reduce){.ds-danger{transition:none}}.ds-danger{background:var(--paper,#fff);color:var(--red,#ac3e43);border-color:#c49a9c}.ds-danger:hover:not(:disabled){background:#f9eded;border-color:var(--red,#ac3e43)}.ds-danger:active:not(:disabled){background:#f9eded}"
    },
