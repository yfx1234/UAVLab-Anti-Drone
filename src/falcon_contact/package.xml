<?xml version="1.0"?>
<package format="3">
  <name>falcon_contact</name>
  <version>0.1.0</version>
  <description>独立的单目软靶直接接触控制节点。</description>
  <maintainer email="user@example.com">falcon team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>anti_drone_interfaces</exec_depend>
  <exec_depend>falcon_intercept</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
