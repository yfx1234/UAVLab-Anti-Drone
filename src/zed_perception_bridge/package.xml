<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zed_perception_bridge</name>
  <version>0.1.0</version>
  <description>感知桥：订阅 /perception/observations_json（PerceptionFrame 合同 v2 的 JSON 通道），
    映射发布 /perception/depth/observation（anti_drone_interfaces/DepthObservation V1），
    供 netgun 拦截链 relative_estimator 消费。</description>
  <maintainer email="user@example.com">falcon team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>anti_drone_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
