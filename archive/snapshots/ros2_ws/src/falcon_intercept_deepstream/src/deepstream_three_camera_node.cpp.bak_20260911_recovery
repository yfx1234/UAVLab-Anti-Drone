    const bool search_camera_active = input_mode == "camera" &&
      (source_mode == "all" || source_mode == "search");
    if (search_camera_active && search_sun_filter_) {
      exposure_guard_.configure(
        search_device, search_exposure_time_, search_gain_, search_brightness_,
        search_backlight_compensation_);
      RCLCPP_INFO(
        get_logger(),
        "search electronic ND enabled exposure=%d gain=%d brightness=%d backlight=%d",
        search_exposure_time_, search_gain_, search_brightness_, search_backlight_compensation_);
    }

    infer_config_path_ = create_infer_config(
      engine_path, onnx_path, parser_path, batch_size, inference_interval, workspace_size_mb,
      confidence, num_detected_classes_, network_mode, model_output_format);
    pipeline_description_ = create_pipeline_description(
      search_device, front_file_path, back_file_path, search_file_path, input_mode,
      infer_config_path_, source_mode, batch_size, mux_width, mux_height, active_source_count_,
      display_enabled_, display_width, display_height, display_sync, csi_fps,
      search_fps, csi_exposure_compensation, front_sensor_id, back_sensor_id,
      record_enabled_, record_output_dir, record_bitrate,
      record_width, record_height, record_segment_seconds);

    GError * error = nullptr;
    pipeline_ = gst_parse_launch(pipeline_description_.c_str(), &error);
    if (pipeline_ == nullptr) {
      const std::string detail = error != nullptr ? error->message : "unknown parse error";
      if (error != nullptr) {
        g_error_free(error);
      }
      throw std::runtime_error("failed to create DeepStream pipeline: " + detail);
    }

    if (roi_enabled_) {
      for (std::size_t index = 0; index < active_source_count_; ++index) {
        const SourceSpec & spec = source_specs_[index];
        if (spec.name != "front" && spec.name != "back") {
          continue;
        }
        const std::string element_name = spec.name + "_roi_convert";
        roi_converters_[index] = gst_bin_get_by_name(GST_BIN(pipeline_), element_name.c_str());
        if (roi_converters_[index] == nullptr) {
          throw std::runtime_error("ROI converter is missing: " + element_name);
        }
        apply_crop_to_converter(index, crop_states_[index].rect);
      }
      roi_subscription_ = create_subscription<std_msgs::msg::String>(
        roi_topic, rclcpp::SensorDataQoS(),
        std::bind(&DeepStreamThreeCameraNode::handle_roi_message, this, std::placeholders::_1));
      roi_watchdog_timer_ = create_wall_timer(
        std::chrono::milliseconds(50),
        std::bind(&DeepStreamThreeCameraNode::check_roi_timeout, this));
    }

    if (color_correction_enabled_) {
      GstElement * mux = gst_bin_get_by_name(GST_BIN(pipeline_), "mux");
      if (mux == nullptr) {
        throw std::runtime_error("nvstreammux element is missing for color correction");
      }
      color_src_pad_ = gst_element_get_static_pad(mux, "src");
      gst_object_unref(mux);
      if (color_src_pad_ == nullptr) {
        throw std::runtime_error("nvstreammux src pad is missing for color correction");
      }
      color_probe_id_ = gst_pad_add_probe(
        color_src_pad_, GST_PAD_PROBE_TYPE_BUFFER,
        &DeepStreamThreeCameraNode::color_probe_callback, this, nullptr);
    }

    GstElement * primary_infer = gst_bin_get_by_name(GST_BIN(pipeline_), "primary_infer");
    if (primary_infer == nullptr) {
      throw std::runtime_error("primary_infer element is missing");
    }
    infer_src_pad_ = gst_element_get_static_pad(primary_infer, "src");
    gst_object_unref(primary_infer);
    if (infer_src_pad_ == nullptr) {
      throw std::runtime_error("primary_infer src pad is missing");
    }
    probe_id_ = gst_pad_add_probe(
      infer_src_pad_, GST_PAD_PROBE_TYPE_BUFFER, &DeepStreamThreeCameraNode::probe_callback,
      this, nullptr);

    if (record_enabled_) {
      // The overlay probe draws detection boxes on every recorded frame by
      // mapping each NVMM buffer to the CPU (~1.5-2 cores at 65 fps total).
      // record_annotate=false keeps raw unannotated recordings and skips it.
      for (std::size_t index = 0; index < active_source_count_; ++index) {
        const std::string element_name = "record_" + source_specs_[index].name + "_overlay";
        GstElement * overlay = gst_bin_get_by_name(GST_BIN(pipeline_), element_name.c_str());
        if (overlay == nullptr) {
          throw std::runtime_error("CPU recording overlay is missing: " + element_name);
        }
        if (record_annotate_) {
          record_overlay_pads_[index] = gst_element_get_static_pad(overlay, "src");
          gst_object_unref(overlay);
          if (record_overlay_pads_[index] == nullptr) {
            throw std::runtime_error("CPU recording overlay src pad is missing: " + element_name);
          }
          record_overlay_contexts_[index] = RecordOverlayContext{this, index};
          record_overlay_probe_ids_[index] = gst_pad_add_probe(
            record_overlay_pads_[index], GST_PAD_PROBE_TYPE_BUFFER,
            &DeepStreamThreeCameraNode::record_overlay_probe_callback,
            &record_overlay_contexts_[index], nullptr);
        } else {
          gst_object_unref(overlay);
        }
      }
    }

    bus_ = gst_element_get_bus(pipeline_);
    const GstStateChangeReturn state_result = gst_element_set_state(pipeline_, GST_STATE_PLAYING);
    if (state_result == GST_STATE_CHANGE_FAILURE) {
      throw std::runtime_error("failed to start DeepStream pipeline");
    }

    bus_timer_ = create_wall_timer(
      std::chrono::milliseconds(100),
      std::bind(&DeepStreamThreeCameraNode::poll_bus, this));

    std::ostringstream source_description;
    for (std::size_t index = 0; index < active_source_count_; ++index) {
      if (index > 0U) {
        source_description << ',';
      }
      const SourceSpec & spec = source_specs_[index];
      source_description << spec.name << ':' << spec.width << 'x' << spec.height;
    }
    RCLCPP_INFO(
      get_logger(),
      "DeepStream native pipeline started engine=%s onnx=%s source_mode=%s batch=%d "
      "csi_fps=%d search_fps=%d mux=%dx%d workspace_mb=%d display=%s preview=%dx%d color_correction=%s "
      "stereo_roi=%s roi_timeout_ms=%ld network_mode=%d output_format=%s classes=%d "
      "class_names=%s record=%s record_annotate=%s record_dir=%s record_video=%dx%d@%d "
      "record_segment_seconds=%d front_sensor_id=%d back_sensor_id=%d sources=%s",
      engine_path.c_str(), onnx_path.c_str(), source_mode.c_str(), batch_size, csi_fps, search_fps, mux_width,
      mux_height, workspace_size_mb, display_enabled_ ? "true" : "false", display_width,
      display_height, color_correction_enabled_ ? "true" : "false",
      roi_enabled_ ? "true" : "false", static_cast<long>(roi_timeout_.count()),
      network_mode, model_output_format.c_str(), num_detected_classes_,
      join_class_names(class_names_).c_str(),
      record_enabled_ ? "true" : "false",
      record_enabled_ && record_annotate_ ? "true" : "false",
      record_enabled_ ? record_output_dir.c_str() : "",
      record_width, record_height, record_bitrate,
      record_segment_seconds,
      front_sensor_id, back_sensor_id,
      source_description.str().c_str());
    if (color_correction_enabled_) {
      const auto print_recipe = [this](const char * name, const FalconColorMatrix & matrix) {
        RCLCPP_INFO(
          get_logger(),
          "stereo color recipe %s matrix=[%.3f,%.3f,%.3f;%.3f,%.3f,%.3f;%.3f,%.3f,%.3f] "
          "pivot=%.2f contrast=%.2f magenta=%.2f gamma=%.2f "
          "color_mix=%.2f gray_mix=%.2f",
          name,
          matrix.values[0], matrix.values[1], matrix.values[2],
          matrix.values[3], matrix.values[4], matrix.values[5],
          matrix.values[6], matrix.values[7], matrix.values[8],
          matrix.contrast_pivot, matrix.contrast,
          matrix.magenta_suppression, matrix.tone_gamma,
          matrix.color_mix, 1.0F - matrix.color_mix);
      };
      print_recipe("front", stereo_color_correction_front_);
      print_recipe("back", stereo_color_correction_back_);
    }
    if (display_enabled_ && active_source_count_ == 3U) {
      RCLCPP_INFO(
        get_logger(),
        "preview layout: top-left=front, top-right=back, bottom-left=search");
    }
    RCLCPP_INFO(get_logger(), "pipeline: %s", pipeline_description_.c_str());
  }

  ~DeepStreamThreeCameraNode() override
  {
    for (GstElement *& converter : roi_converters_) {
      if (converter != nullptr) {
        gst_object_unref(converter);
        converter = nullptr;
      }
    }
    if (color_src_pad_ != nullptr) {
      if (color_probe_id_ != 0U) {
        gst_pad_remove_probe(color_src_pad_, color_probe_id_);
      }
      gst_object_unref(color_src_pad_);
      color_src_pad_ = nullptr;
    }
    if (pipeline_ != nullptr) {
      gst_element_send_event(pipeline_, gst_event_new_eos());
      if (record_enabled_ && bus_ != nullptr) {
        GstMessage * final_message = gst_bus_timed_pop_filtered(
          bus_, 5 * GST_SECOND,
          static_cast<GstMessageType>(GST_MESSAGE_EOS | GST_MESSAGE_ERROR));
        if (final_message != nullptr) {
          gst_message_unref(final_message);
        } else {
          RCLCPP_WARN(get_logger(), "timed out waiting for recording muxers to finalize");
        }
      }
      gst_element_set_state(pipeline_, GST_STATE_NULL);
    }
    for (std::size_t index = 0; index < active_source_count_; ++index) {
      if (record_overlay_pads_[index] != nullptr) {
        if (record_overlay_probe_ids_[index] != 0U) {
          gst_pad_remove_probe(
            record_overlay_pads_[index], record_overlay_probe_ids_[index]);
        }
        gst_object_unref(record_overlay_pads_[index]);
        record_overlay_pads_[index] = nullptr;
      }
    }
    if (infer_src_pad_ != nullptr) {
      if (probe_id_ != 0U) {
        gst_pad_remove_probe(infer_src_pad_, probe_id_);
      }
      gst_object_unref(infer_src_pad_);
      infer_src_pad_ = nullptr;
    }
    if (bus_ != nullptr) {
      gst_object_unref(bus_);
      bus_ = nullptr;
    }
    if (pipeline_ != nullptr) {
      gst_object_unref(pipeline_);
      pipeline_ = nullptr;
    }
    if (search_sun_filter_) {
      const bool restored = exposure_guard_.restore();
      RCLCPP_INFO(
        get_logger(), "search camera automatic exposure restore=%s",
        restored ? "success" : "failed");
    }
    if (!infer_config_path_.empty()) {
      std::remove(infer_config_path_.c_str());
    }
  }

private:
  static RoiRect full_frame_rect(const SourceSpec & spec)
  {
    return RoiRect{0U, 0U, spec.width, spec.height};
  }

  void apply_crop_to_converter(std::size_t source_id, const RoiRect & rect)
  {
    GstElement * converter = roi_converters_[source_id];
    if (converter == nullptr) {
      return;
    }
    // VIC supports scale factors up to 16x per dimension.  The ROI converter
    // outputs mux_width_ x mux_height_, so the crop must be at least
    // (mux/16) in each dimension, otherwise nvvideoconvert fails with
    // "image scale factor exceeds 16" and kills the whole pipeline
    // (2026-08-05 field crash).  Expand undersized crops around their
    // centre instead of passing them through or discarding the ROI.
    RoiRect safe = rect;
    const unsigned int min_w = static_cast<unsigned int>((mux_width_ + 15) / 16);
    const unsigned int min_h = static_cast<unsigned int>((mux_height_ + 15) / 16);
    const SourceSpec & spec = source_specs_[source_id];
    const auto expand_axis = [](unsigned int & a1, unsigned int & a2, unsigned int min_size,
                                unsigned int limit) {
      if (a2 - a1 >= min_size) {
        return;
      }
      const unsigned int center = (a1 + a2) / 2;
      a1 = center > min_size / 2 ? center - min_size / 2 : 0;
      a2 = a1 + min_size;
      if (a2 > limit) {
        a2 = limit;
        a1 = a2 - min_size;
      }
    };
    expand_axis(safe.x1, safe.x2, min_w, spec.width);
    expand_axis(safe.y1, safe.y2, min_h, spec.height);
    // Keep NV12 crop coordinates/extents even after expansion.
    safe.x1 &= ~1U;
    safe.y1 &= ~1U;
    safe.x2 = std::min(spec.width, (safe.x2 + 1U) & ~1U);
    safe.y2 = std::min(spec.height, (safe.y2 + 1U) & ~1U);
    const std::string crop = std::to_string(safe.x1) + ":" + std::to_string(safe.y1) + ":" +
      std::to_string(safe.width()) + ":" + std::to_string(safe.height());
    g_object_set(G_OBJECT(converter), "src-crop", crop.c_str(), nullptr);
  }

  void publish_roi_status_locked(const std::string & reason)
  {
    if (roi_status_publisher_ == nullptr) {
      return;
    }
    std::ostringstream json;
    json << "{\"enabled\":" << (roi_enabled_ ? "true" : "false")
         << ",\"reason\":\"" << reason << "\",\"generation\":" << roi_generation_
         << ",\"streams\":{";
    bool first = true;
    for (std::size_t index = 0; index < active_source_count_; ++index) {
      const SourceSpec & spec = source_specs_[index];
      if (spec.name != "front" && spec.name != "back") {
        continue;
      }
      if (!first) {
        json << ',';
      }
      first = false;
      const CropState & state = crop_states_[index];
      json << "\"" << spec.name << "\":{\"active\":"
           << (state.active ? "true" : "false") << ",\"roi\":{\"x1\":"
           << state.rect.x1 << ",\"y1\":" << state.rect.y1 << ",\"x2\":"
           << state.rect.x2 << ",\"y2\":" << state.rect.y2 << "}}";
    }
    json << "}}";
    std_msgs::msg::String message;
    message.data = json.str();
    roi_status_publisher_->publish(message);
  }

  void fallback_to_full_frame(const std::string & reason)
  {
    std::lock_guard<std::mutex> lock(roi_mutex_);
    bool changed = roi_status_reason_ != reason;
    for (std::size_t index = 0; index < active_source_count_; ++index) {
      const SourceSpec & spec = source_specs_[index];
      if (spec.name != "front" && spec.name != "back") {
        continue;
      }
      CropState & state = crop_states_[index];
      const RoiRect full = full_frame_rect(spec);
      const bool stream_changed = state.active || state.rect.x1 != full.x1 ||
        state.rect.y1 != full.y1 || state.rect.x2 != full.x2 || state.rect.y2 != full.y2;
      if (stream_changed) {
        changed = true;
        state.active = false;
        state.rect = full;
        state.generation = ++roi_generation_;
        apply_crop_to_converter(index, state.rect);
      }
    }
    roi_status_reason_ = reason;
    if (changed) {
      publish_roi_status_locked(reason);
      RCLCPP_INFO(get_logger(), "stereo ROI fallback to full frame: %s", reason.c_str());
    }
  }

  void handle_roi_message(const std_msgs::msg::String::SharedPtr message)
  {
    if (!roi_enabled_ || message == nullptr) {
      return;
    }
    const auto valid = json_bool_for_key(message->data, "valid");
    if (!valid.has_value()) {
      fallback_to_full_frame("malformed_roi_json");
      return;
    }
    if (!*valid) {
      fallback_to_full_frame(json_string_for_key(message->data, "reason").value_or("roi_invalid"));
      return;
    }
    const auto rois_json = json_object_for_key(message->data, "rois");
    if (!rois_json) {
      fallback_to_full_frame("missing_rois_object");
      return;
    }

    std::array<std::optional<RoiRect>, kSourceCount> parsed{};
    for (std::size_t index = 0; index < active_source_count_; ++index) {
      const SourceSpec & spec = source_specs_[index];
      if (spec.name != "front" && spec.name != "back") {
        continue;
      }
      const auto stream_json = json_object_for_key(*rois_json, spec.name);
      if (!stream_json) {
        fallback_to_full_frame("missing_" + spec.name + "_roi");
        return;
      }
      parsed[index] = parse_roi_rect(
        *stream_json, spec.width, spec.height, roi_minimum_size_);
      if (!parsed[index]) {
        fallback_to_full_frame("invalid_" + spec.name + "_roi");
        return;
      }
    }

    const auto received_at = std::chrono::steady_clock::now();
    std::lock_guard<std::mutex> lock(roi_mutex_);
    bool changed = roi_status_reason_ != "active";
    for (std::size_t index = 0; index < active_source_count_; ++index) {
      if (!parsed[index]) {
        continue;
      }
      CropState & state = crop_states_[index];
      const RoiRect & rect = *parsed[index];
      const bool rect_changed = !state.active || state.rect.x1 != rect.x1 ||
        state.rect.y1 != rect.y1 || state.rect.x2 != rect.x2 || state.rect.y2 != rect.y2;
      state.received_at = received_at;
      if (rect_changed) {
        state.rect = rect;
        state.active = true;
        state.generation = ++roi_generation_;
        apply_crop_to_converter(index, rect);
        changed = true;
      }
    }
    roi_status_reason_ = "active";
    if (changed) {
      publish_roi_status_locked("active");
      RCLCPP_INFO(
        get_logger(), "stereo ROI activated generation=%lu",
        static_cast<unsigned long>(roi_generation_));
    }
  }

  void check_roi_timeout()
  {
    if (!roi_enabled_) {
      return;
    }
    const auto current = std::chrono::steady_clock::now();
    bool timed_out = false;
    {
      std::lock_guard<std::mutex> lock(roi_mutex_);
      for (std::size_t index = 0; index < active_source_count_; ++index) {
        const CropState & state = crop_states_[index];
        if (state.active && current - state.received_at > roi_timeout_) {
          timed_out = true;
          break;
        }
      }
    }
    if (timed_out) {
      fallback_to_full_frame("roi_timeout");
    }
  }

  static std::unordered_set<int> parse_class_filter(const std::string & text)
  {
    std::unordered_set<int> values;
    std::istringstream stream(text);
    std::string token;
    while (std::getline(stream, token, ',')) {
      if (!token.empty()) {
        values.insert(std::stoi(token));
      }
    }
    return values;
  }

  static std::vector<std::string> parse_class_names(const std::string & text)
  {
    std::vector<std::string> values;
    std::istringstream stream(text);
    std::string token;
    while (std::getline(stream, token, ',')) {
      const auto first = token.find_first_not_of(" \t");
      if (first == std::string::npos) {
        continue;
      }
      const auto last = token.find_last_not_of(" \t");
      values.push_back(token.substr(first, last - first + 1U));
    }
    return values;
  }

  static std::string join_class_names(const std::vector<std::string> & names)
  {
    std::ostringstream stream;
    for (std::size_t index = 0; index < names.size(); ++index) {
      if (index > 0U) {
        stream << ',';
      }
      stream << names[index];
    }
    return stream.str();
  }

  std::string create_infer_config(
    const std::string & engine_path,
    const std::string & onnx_path,
    const std::string & parser_path,
    int batch_size,
    int inference_interval,
    int workspace_size_mb,
    double confidence,
    int num_detected_classes,
    int network_mode,
    const std::string & model_output_format) const
  {
    const std::string path = "/tmp/falcon_yolo26_nvinfer_" +
      std::to_string(static_cast<long long>(getpid())) + ".txt";
    std::ofstream config(path, std::ios::out | std::ios::trunc);
    if (!config) {
      throw std::runtime_error("cannot write nvinfer config: " + path);
    }
    config << "[property]\n";
    config << "gpu-id=0\n";
    config << "net-scale-factor=0.00392156862745098\n";
    config << "model-color-format=0\n";
    if (std::filesystem::exists(onnx_path)) {
      config << "onnx-file=" << onnx_path << "\n";
    }
    config << "model-engine-file=" << engine_path << "\n";
    config << "batch-size=" << batch_size << "\n";
    config << "process-mode=1\n";
    config << "network-mode=" << network_mode << "\n";
    config << "network-type=0\n";
    config << "num-detected-classes=" << num_detected_classes << "\n";
    config << "interval=" << inference_interval << "\n";
    if (workspace_size_mb > 0) {
      config << "workspace-size=" << workspace_size_mb << "\n";
    }
    config << "gie-unique-id=1\n";
    config << "cluster-mode=" << (model_output_format == "raw" ? 2 : 4) << "\n";
    config << "maintain-aspect-ratio=1\n";
    config << "symmetric-padding=1\n";
    config << "scaling-compute-hw=1\n";
    config << "output-blob-names=output0\n";
    config << "parse-bbox-func-name="
           << (model_output_format == "raw" ?
      "NvDsInferParseYolo26Raw" : "NvDsInferParseYolo26EndToEnd") << "\n";
    config << "custom-lib-path=" << parser_path << "\n\n";
    config << "[class-attrs-all]\n";
    config << "pre-cluster-threshold=" << std::fixed << std::setprecision(6)
           << confidence << "\n";
    if (model_output_format == "raw") {
      config << "nms-iou-threshold=0.450000\n";
    }
    config << "topk=300\n";
    config.close();
    return path;
  }

  static std::string create_pipeline_description(
    const std::string & search_device,
    const std::string & front_file_path,
    const std::string & back_file_path,
    const std::string & search_file_path,
    const std::string & input_mode,
    const std::string & infer_config,
    const std::string & source_mode,
    int batch_size,
    int mux_width,
    int mux_height,
    std::size_t source_count,
    bool display_enabled,
    int display_width,
    int display_height,
    bool display_sync,
    int csi_fps,
    int search_fps,
    double csi_exposure_compensation,
    int front_sensor_id,
    int back_sensor_id,
    bool record_enabled,
    const std::string & record_output_dir,
    int record_bitrate,
    int record_width,
    int record_height,
    int record_segment_seconds)
  {
    const bool file_input = input_mode == "files";
    std::ostringstream pipeline;
    pipeline
      << "nvstreammux name=mux batch-size=" << batch_size
      << " width=" << mux_width << " height=" << mux_height
      << " live-source=" << (file_input ? "false" : "true")
      << " attach-sys-ts=" << (file_input ? "false" : "true")
      << " batched-push-timeout=40000 "
      << "sync-inputs=false ! "
      << "nvinfer name=primary_infer config-file-path=" << quote_gstreamer(infer_config)
      << " ! ";

    if (!record_enabled) {
      if (file_input) {
        pipeline << "queue max-size-buffers=2 max-size-bytes=0 max-size-time=0 ! ";
      } else {
        pipeline << "queue leaky=2 max-size-buffers=1 max-size-bytes=0 max-size-time=0 ! ";
      }
    }

    if (display_enabled) {
      const std::size_t columns = source_count > 1U ? 2U : 1U;
      const std::size_t rows = (source_count + columns - 1U) / columns;
      pipeline
        << "nvmultistreamtiler name=preview_tiler rows=" << rows
        << " columns=" << columns << " width=" << display_width
        << " height=" << display_height << " ! ";
      pipeline
        << "nvvideoconvert ! video/x-raw(memory:NVMM),format=RGBA ! "
        << "nvdsosd name=preview_osd process-mode=1 display-text=true ! ";
      pipeline
        << "nveglglessink name=preview_sink sync="
        << (display_sync ? "true" : "false") << " async=false qos=false ";
    } else if (!record_enabled) {
      pipeline << "fakesink sync=false async=false qos=false ";
    }

    if (record_enabled) {
      pipeline
        << "queue max-size-buffers=8 max-size-bytes=0 max-size-time=0 ! "
        << "nvstreamdemux name=record_demux ";
      std::vector<std::string> record_source_names;
      if (source_mode == "all") {
        record_source_names = {"front", "back", "search"};
      } else {
        record_source_names = {source_mode};
      }
      for (std::size_t index = 0; index < record_source_names.size(); ++index) {
        const std::string & name = record_source_names[index];
        const std::filesystem::path output_path =
          std::filesystem::path(record_output_dir) / (name + "_yolo_%05d.mkv");
        pipeline
          << "record_demux.src_" << index
          << " ! queue max-size-buffers=8 max-size-bytes=0 max-size-time=0 ! "
          << "nvvideoconvert ! video/x-raw,width=" << record_width
          << ",height=" << record_height << ",format=BGRx ! "
          << "identity name=record_" << name << "_overlay ! "
          << "videoconvert ! video/x-raw,format=I420 ! "
          << "x264enc name=record_" << name << "_encoder bitrate="
          << std::max(1000, record_bitrate / 1000)
          << " speed-preset=ultrafast tune=zerolatency key-int-max=30 "
          << "bframes=0 byte-stream=false ! h264parse ! "
          << "splitmuxsink name=record_" << name << "_sink location="
          << quote_gstreamer(output_path.string())
          << " max-size-time=" << (static_cast<std::uint64_t>(record_segment_seconds) *
          GST_SECOND)
          << " max-size-bytes=0 async-finalize=true "
          << "muxer-factory=matroskamux "
          << "muxer-properties=\"properties,streamable=true\" ";
      }
    }

    unsigned int sink_index = 0U;
    const auto append_file =
      [&pipeline, &sink_index, mux_width, mux_height, search_fps](
      const std::string & path, const std::string & name) {
        pipeline
          << "filesrc location=" << quote_gstreamer(path) << " ! matroskademux ! "
          << "jpegparse name=" << name << "_jpeg_parser ! "
          << "nvv4l2decoder mjpeg=true ! videorate drop-only=true ! "
          << "video/x-raw(memory:NVMM),framerate=" << search_fps << "/1 ! identity sync=true ! "
          << "nvvideoconvert name=" << name << "_roi_convert interpolation-method=2 ! "
          << "video/x-raw(memory:NVMM),width=" << mux_width << ",height=" << mux_height
          << ",format=NV12 ! queue max-size-buffers=4 max-size-bytes=0 max-size-time=0 ! "
          << "mux.sink_" << sink_index++ << ' ';
      };
    const auto append_argus =
      [&pipeline, &sink_index, mux_width, mux_height, csi_fps,
        csi_exposure_compensation](int sensor_id, const std::string & name) {
        pipeline
          << "nvarguscamerasrc sensor-id=" << sensor_id
          << " wbmode=1 awblock=false exposurecompensation="
          << std::fixed << std::setprecision(2) << csi_exposure_compensation << " ! "
          << "video/x-raw(memory:NVMM),width=3840,height=2160,framerate=" << csi_fps << "/1,format=NV12 ! "
          << "queue leaky=2 max-size-buffers=2 max-size-bytes=0 max-size-time=0 ! "
          << "nvvideoconvert name=" << name << "_roi_convert interpolation-method=2 ! "
          << "video/x-raw(memory:NVMM),width=" << mux_width << ",height=" << mux_height
          << ",format=NV12 ! queue leaky=2 max-size-buffers=2 max-size-bytes=0 "
          << "max-size-time=0 ! mux.sink_"
          << sink_index++ << ' ';
      };
    const auto append_search =
      [&pipeline, &sink_index, &search_device, mux_width, mux_height, search_fps]() {
        pipeline
          << "v4l2src device=" << quote_gstreamer(search_device) << " io-mode=2 ! "
          << "image/jpeg,width=2560,height=1440,framerate=25/1 ! "
          // Leaky queue directly at the source: when the MJPEG decode chain is
          // momentarily slower than 25 fps, stale frames are dropped here
          // instead of accumulating in the v4l2 driver ring (observed 2026-08-13:
          // search PTS lag grew ~6.4 ms/s unbounded, starving the controller's
          // 0.25 s observation freshness gate).
          << "queue name=search_source_queue leaky=2 max-size-buffers=2 "
          << "max-size-bytes=0 max-size-time=0 ! jpegparse ! "
          // Thin the MJPEG stream to 15 fps BEFORE the decoder (2026-08-13):
          // at 25 fps the 1440p decode chain cannot quite keep up under flight
          // load, so buffers pile up inside the decoder's V4L2 ring and the
          // search PTS lag drifted past the controller's 0.25 s freshness gate
          // (median 290 ms, still growing). MJPEG frames are independent, so
          // dropping them pre-decode is safe; 15 fps keeps the observation
          // stream fresh (one frame every 66 ms) with healthy margin.
          << "videorate drop-only=true ! image/jpeg,framerate=" << search_fps << "/1 ! "
          << "nvv4l2decoder mjpeg=true ! nvvideoconvert name=search_convert ! "
          << "video/x-raw(memory:NVMM),width=" << mux_width << ",height=" << mux_height
          << ",format=NV12 ! "
          << "queue leaky=2 max-size-buffers=2 max-size-bytes=0 max-size-time=0 ! mux.sink_"
          << sink_index++;
      };

    if (file_input) {
      if (source_mode == "all") {
        append_file(front_file_path, "front");
        append_file(back_file_path, "back");
        append_file(search_file_path, "search");
      } else if (source_mode == "front") {
        append_file(front_file_path, "front");
      } else if (source_mode == "back") {
        append_file(back_file_path, "back");
      } else {
        append_file(search_file_path, "search");
      }
    } else {
      if (source_mode == "all") {
        append_argus(front_sensor_id, "front");
        append_argus(back_sensor_id, "back");
        append_search();
      } else if (source_mode == "front") {
        append_argus(front_sensor_id, "front");
      } else if (source_mode == "back") {
        append_argus(back_sensor_id, "back");
      } else {
        append_search();
      }
    }
    return pipeline.str();
  }

  static GstPadProbeReturn probe_callback(
    GstPad *, GstPadProbeInfo * info, gpointer user_data)
  {
    auto * self = static_cast<DeepStreamThreeCameraNode *>(user_data);
    GstBuffer * buffer = GST_PAD_PROBE_INFO_BUFFER(info);
    if (self == nullptr || buffer == nullptr) {
      return GST_PAD_PROBE_OK;
    }
    return self->handle_buffer(buffer);
  }

  static GstPadProbeReturn color_probe_callback(
    GstPad *, GstPadProbeInfo * info, gpointer user_data)
  {
    auto * self = static_cast<DeepStreamThreeCameraNode *>(user_data);
    GstBuffer * buffer = GST_PAD_PROBE_INFO_BUFFER(info);
    if (self == nullptr || buffer == nullptr) {
      return GST_PAD_PROBE_OK;
    }
    return self->handle_color_buffer(buffer);
  }

  static GstPadProbeReturn record_overlay_probe_callback(
    GstPad *, GstPadProbeInfo * info, gpointer user_data)
  {
    auto * context = static_cast<RecordOverlayContext *>(user_data);
    GstBuffer * buffer = GST_PAD_PROBE_INFO_BUFFER(info);
    if (context == nullptr || context->node == nullptr || buffer == nullptr) {
      return GST_PAD_PROBE_OK;
    }
    return context->node->draw_recording_boxes(buffer, context->source_index);
  }

  static void set_bgrx_pixel(
    guint8 * pixels, std::size_t stride, int x, int y,
    guint8 blue, guint8 green, guint8 red)
  {
    guint8 * pixel = pixels + static_cast<std::size_t>(y) * stride +
      static_cast<std::size_t>(x) * 4U;
    pixel[0] = blue;
    pixel[1] = green;
    pixel[2] = red;
    pixel[3] = 255U;
  }

  GstPadProbeReturn draw_recording_boxes(GstBuffer * buffer, std::size_t source_index)
  {
    if (source_index >= active_source_count_) {
      return GST_PAD_PROBE_OK;
    }
    NvDsBatchMeta * batch_meta = gst_buffer_get_nvds_batch_meta(buffer);
    if (batch_meta == nullptr) {
      return GST_PAD_PROBE_OK;
    }

    GstMapInfo map_info = GST_MAP_INFO_INIT;
    if (!gst_buffer_map(buffer, &map_info, GST_MAP_READWRITE)) {
      if (record_overlay_errors_++ < 5U) {
        RCLCPP_ERROR(get_logger(), "failed to map CPU recording frame for annotation");
      }
      return GST_PAD_PROBE_OK;
    }

    const std::size_t minimum_stride = static_cast<std::size_t>(record_width_) * 4U;
    const std::size_t stride = record_height_ > 0 ?
      map_info.size / static_cast<std::size_t>(record_height_) : 0U;
    if (stride < minimum_stride ||
      map_info.size < stride * static_cast<std::size_t>(record_height_))
    {
      const std::size_t mapped_size = map_info.size;
      gst_buffer_unmap(buffer, &map_info);
      if (record_overlay_errors_++ < 5U) {
        RCLCPP_ERROR(
          get_logger(), "unexpected CPU recording frame layout size=%zu stride=%zu",
          mapped_size, stride);
      }
      return GST_PAD_PROBE_OK;
    }

    guint8 blue = 50U;
    guint8 green = 255U;
    guint8 red = 50U;
    const std::string & source_name = source_specs_[source_index].name;
    if (source_name == "back") {
      blue = 255U;
      green = 210U;
      red = 30U;
    } else if (source_name == "search") {
      blue = 20U;
      green = 210U;
      red = 255U;
    }

    for (NvDsMetaList * frame_item = batch_meta->frame_meta_list;
      frame_item != nullptr; frame_item = frame_item->next)
    {
      auto * frame_meta = static_cast<NvDsFrameMeta *>(frame_item->data);
      if (frame_meta == nullptr) {
        continue;
      }
      const double pipeline_width = static_cast<double>(
        frame_meta->pipeline_width > 0U ? frame_meta->pipeline_width :
        static_cast<guint>(mux_width_));
      const double pipeline_height = static_cast<double>(
        frame_meta->pipeline_height > 0U ? frame_meta->pipeline_height :
        static_cast<guint>(mux_height_));
      const double scale_x = static_cast<double>(record_width_) / pipeline_width;
      const double scale_y = static_cast<double>(record_height_) / pipeline_height;

      for (NvDsMetaList * object_item = frame_meta->obj_meta_list;
        object_item != nullptr; object_item = object_item->next)
      {
        auto * object_meta = static_cast<NvDsObjectMeta *>(object_item->data);
        if (object_meta == nullptr || object_meta->class_id < 0 ||
          (!class_filter_.empty() &&
          class_filter_.count(object_meta->class_id) == 0U))
        {
          continue;
        }

        const int x1 = std::clamp(
          static_cast<int>(std::lround(object_meta->rect_params.left * scale_x)),
          0, record_width_ - 1);
        const int y1 = std::clamp(
          static_cast<int>(std::lround(object_meta->rect_params.top * scale_y)),
          0, record_height_ - 1);
        const int x2 = std::clamp(
          static_cast<int>(std::lround(
            (object_meta->rect_params.left + object_meta->rect_params.width) * scale_x)),
          0, record_width_ - 1);
        const int y2 = std::clamp(
          static_cast<int>(std::lround(
            (object_meta->rect_params.top + object_meta->rect_params.height) * scale_y)),
          0, record_height_ - 1);
        if (x2 <= x1 || y2 <= y1) {
          continue;
        }

        constexpr int border = 4;
        for (int thickness = 0; thickness < border; ++thickness) {
          const int top = std::min(y2, y1 + thickness);
          const int bottom = std::max(y1, y2 - thickness);
          for (int x = x1; x <= x2; ++x) {
            set_bgrx_pixel(map_info.data, stride, x, top, blue, green, red);
            set_bgrx_pixel(map_info.data, stride, x, bottom, blue, green, red);
          }
          const int left = std::min(x2, x1 + thickness);
          const int right = std::max(x1, x2 - thickness);
          for (int y = y1; y <= y2; ++y) {
            set_bgrx_pixel(map_info.data, stride, left, y, blue, green, red);
            set_bgrx_pixel(map_info.data, stride, right, y, blue, green, red);
          }
        }

        const int confidence_width = std::clamp(
          static_cast<int>(std::lround(
            object_meta->confidence * static_cast<double>(x2 - x1 + 1))),
          1, x2 - x1 + 1);
        const int bar_top = std::max(0, y1 - 6);
        for (int y = bar_top; y < y1; ++y) {
          for (int x = x1; x < x1 + confidence_width; ++x) {
            set_bgrx_pixel(map_info.data, stride, x, y, blue, green, red);
          }
        }
      }
    }

    gst_buffer_unmap(buffer, &map_info);
    ++record_overlay_frames_[source_index];
    return GST_PAD_PROBE_OK;
  }

  GstPadProbeReturn handle_color_buffer(GstBuffer * buffer)
  {
    NvDsBatchMeta * batch_meta = gst_buffer_get_nvds_batch_meta(buffer);
    if (batch_meta == nullptr) {
      report_color_error("nvstreammux output has no NvDsBatchMeta");
      return GST_PAD_PROBE_OK;
    }

    GstMapInfo map_info = GST_MAP_INFO_INIT;
    if (!gst_buffer_map(buffer, &map_info, GST_MAP_READWRITE)) {
      report_color_error("failed to map GstBuffer to NvBufSurface");
      return GST_PAD_PROBE_OK;
    }
    auto * surface = reinterpret_cast<NvBufSurface *>(map_info.data);

    for (NvDsMetaList * frame_item = batch_meta->frame_meta_list;
      frame_item != nullptr; frame_item = frame_item->next)
    {
      auto * frame_meta = static_cast<NvDsFrameMeta *>(frame_item->data);
      if (frame_meta == nullptr || frame_meta->source_id >= active_source_count_) {
        continue;
      }

      const std::string & source_name = source_specs_[frame_meta->source_id].name;
      if (source_name != "front" && source_name != "back") {
        continue;
      }
      const FalconColorMatrix & correction =
        (source_name == "back")
          ? stereo_color_correction_back_
          : stereo_color_correction_front_;

      const guint batch_index = frame_meta->batch_id;
      if (batch_index >= surface->numFilled) {
        report_color_error("frame batch_id exceeds NvBufSurface numFilled");
        continue;
      }
      if (NvBufSurfaceMapEglImage(surface, static_cast<int>(batch_index)) != 0) {
        report_color_error("NvBufSurfaceMapEglImage failed");
        continue;
      }

      EGLImageKHR image = reinterpret_cast<EGLImageKHR>(
        surface->surfaceList[batch_index].mappedAddr.eglImage);
      const bool applied = image != nullptr &&
        falcon_apply_nv12_color_matrix(image, correction);
      if (!applied) {
        report_color_error("CUDA color matrix failed");
      } else {
        ++color_corrected_frames_;
      }

      if (NvBufSurfaceUnMapEglImage(surface, static_cast<int>(batch_index)) != 0) {
        report_color_error("NvBufSurfaceUnMapEglImage failed");
      }
    }

    gst_buffer_unmap(buffer, &map_info);
    if (color_corrected_frames_ > 0U && color_corrected_frames_ % 300U == 0U) {
      RCLCPP_INFO(
        get_logger(), "color correction stats applied=%lu errors=%lu",
        static_cast<unsigned long>(color_corrected_frames_),
        static_cast<unsigned long>(color_errors_));
    }
    return GST_PAD_PROBE_OK;
  }

  void report_color_error(const char * message)
  {
    ++color_errors_;
    if (color_errors_ <= 5U) {
      RCLCPP_ERROR(
        get_logger(), "stereo color correction error #%lu: %s",
        static_cast<unsigned long>(color_errors_), message);
    }
  }

  GstPadProbeReturn handle_buffer(GstBuffer * buffer)
  {
    NvDsBatchMeta * batch_meta = gst_buffer_get_nvds_batch_meta(buffer);
    if (batch_meta == nullptr) {
      RCLCPP_WARN_THROTTLE(
        get_logger(), *get_clock(), 5000, "DeepStream buffer has no NvDsBatchMeta");
      return GST_PAD_PROBE_OK;
    }

    for (NvDsMetaList * frame_item = batch_meta->frame_meta_list;
      frame_item != nullptr; frame_item = frame_item->next)
    {
      auto * frame_meta = static_cast<NvDsFrameMeta *>(frame_item->data);
      if (frame_meta == nullptr || frame_meta->source_id >= active_source_count_) {
        continue;
      }
      publish_frame(*frame_meta, *batch_meta);
    }
    report_stats_if_due();
    return GST_PAD_PROBE_OK;
  }

  void publish_frame(const NvDsFrameMeta & frame_meta, NvDsBatchMeta & batch_meta)
  {
    const std::size_t source_id = frame_meta.source_id;
    const SourceSpec & spec = source_specs_[source_id];
    const double pipeline_width = static_cast<double>(
      frame_meta.pipeline_width > 0U ? frame_meta.pipeline_width : 1280U);
    const double pipeline_height = static_cast<double>(
      frame_meta.pipeline_height > 0U ? frame_meta.pipeline_height : 720U);
    const double source_width = static_cast<double>(spec.width);
    const double source_height = static_cast<double>(spec.height);
    CropState crop_state;
    {
      std::lock_guard<std::mutex> lock(roi_mutex_);
      crop_state = crop_states_[source_id];
    }
    const RoiRect & crop = crop_state.rect;
    const double scale_x = static_cast<double>(crop.width()) / pipeline_width;
    const double scale_y = static_cast<double>(crop.height()) / pipeline_height;
    const double roi_age_ms = crop_state.active ? std::chrono::duration<double, std::milli>(
      std::chrono::steady_clock::now() - crop_state.received_at).count() : -1.0;

    const uint64_t host_receive_ns = static_cast<uint64_t>(now().nanoseconds());
    uint64_t stamp_ns = host_receive_ns;
    const char * timestamp_source = "ros_receive_time";
    if (pipeline_ != nullptr && frame_meta.buf_pts != GST_CLOCK_TIME_NONE) {
      GstClock * pipeline_clock = gst_element_get_clock(pipeline_);
      if (pipeline_clock != nullptr) {
        const GstClockTime clock_now = gst_clock_get_time(pipeline_clock);
        const GstClockTime base_time = gst_element_get_base_time(pipeline_);
        if (clock_now >= base_time) {
          const GstClockTime running_time = clock_now - base_time;
          if (running_time >= frame_meta.buf_pts) {
            const uint64_t age_ns = static_cast<uint64_t>(running_time - frame_meta.buf_pts);
            if (stamp_ns > age_ns) {
              stamp_ns -= age_ns;
              timestamp_source = "gstreamer_source_pts";
            }
          }
        }
        gst_object_unref(pipeline_clock);
      }
    }
    const uint64_t stamp_sec = stamp_ns / 1000000000ULL;
    const uint64_t stamp_nanosec = stamp_ns % 1000000000ULL;
    const uint64_t host_receive_sec = host_receive_ns / 1000000000ULL;
    const uint64_t host_receive_nanosec = host_receive_ns % 1000000000ULL;
    uint32_t sequence = static_cast<uint32_t>(frame_meta.frame_num);
    if (sequence_initialized_[source_id] && sequence <= source_sequences_[source_id]) {
      sequence = source_sequences_[source_id] + 1U;
    }
    source_sequences_[source_id] = sequence;
    sequence_initialized_[source_id] = true;

    std::ostringstream json;
    json << std::fixed << std::setprecision(3);
    json << "{\"header\":{\"stamp\":{\"sec\":" << stamp_sec
         << ",\"nanosec\":" << stamp_nanosec << "},\"frame_id\":\""
         << spec.frame_id << "\"},\"image_width\":"
         << static_cast<unsigned int>(source_width) << ",\"image_height\":"
         << static_cast<unsigned int>(source_height) << ",\"sequence\":" << sequence
         << ",\"timestamp_source\":\"" << timestamp_source
         << "\",\"host_receive_time\":{\"sec\":" << host_receive_sec
         << ",\"nanosec\":" << host_receive_nanosec
         << "},\"timestamp_sigma_s\":" << timestamp_sigma_s_
         << ",\"exposure_time_s\":-1.0,\"frame_readout_time_s\":-1.0"
         << ",\"source\":\"deepstream_"
         << (crop_state.active ? "roi" : "full_frame") << "\",\"roi_runtime\":{\"active\":"
         << (crop_state.active ? "true" : "false") << ",\"generation\":"
         << crop_state.generation << ",\"age_ms\":" << roi_age_ms
         << ",\"roi\":{\"x1\":" << crop.x1 << ",\"y1\":" << crop.y1
         << ",\"x2\":" << crop.x2 << ",\"y2\":" << crop.y2
         << "}},\"detections\":[";

    bool first = true;
    uint64_t detection_count = 0;
    for (NvDsMetaList * object_item = frame_meta.obj_meta_list;
      object_item != nullptr; object_item = object_item->next)
    {
      auto * object_meta = static_cast<NvDsObjectMeta *>(object_item->data);
      if (object_meta == nullptr || object_meta->class_id < 0) {
        continue;
      }
      const int class_id = object_meta->class_id;
      const char * class_name = class_id >= 0 &&
        static_cast<std::size_t>(class_id) < class_names_.size() ?
        class_names_[static_cast<std::size_t>(class_id)].c_str() : "unknown";
      if (!class_filter_.empty() && class_filter_.count(object_meta->class_id) == 0U) {
        if (decorate_enabled_) {
          object_meta->rect_params.border_width = 0U;
          if (object_meta->text_params.display_text != nullptr) {
            g_free(object_meta->text_params.display_text);
            object_meta->text_params.display_text = nullptr;
          }
        }
        continue;
      }

      if (decorate_enabled_) {
        decorate_object(*object_meta, spec, class_name);
      }

      const double x1 = clamp_value(
        static_cast<double>(crop.x1) +
        static_cast<double>(object_meta->rect_params.left) * scale_x, 0.0, source_width);
      const double y1 = clamp_value(
        static_cast<double>(crop.y1) +
        static_cast<double>(object_meta->rect_params.top) * scale_y, 0.0, source_height);
      const double x2 = clamp_value(
        static_cast<double>(crop.x1) +
        static_cast<double>(object_meta->rect_params.left + object_meta->rect_params.width) *
        scale_x, 0.0, source_width);
      const double y2 = clamp_value(
        static_cast<double>(crop.y1) +
        static_cast<double>(object_meta->rect_params.top + object_meta->rect_params.height) *
        scale_y, 0.0, source_height);
      if (!(x2 > x1 && y2 > y1)) {
        continue;
      }
      if (!first) {
        json << ',';
      }
      first = false;
      json << "{\"class_id\":" << class_id << ",\"class_name\":\""
           << class_name << "\",\"confidence\":" << object_meta->confidence
           << ",\"bbox_xyxy\":[" << x1 << ',' << y1 << ',' << x2 << ',' << y2
           << "],\"bbox_xywh\":[" << x1 << ',' << y1 << ',' << (x2 - x1) << ','
           << (y2 - y1) << "],\"bbox_center\":[" << ((x1 + x2) / 2.0) << ','
           << ((y1 + y2) / 2.0) << "]}";
      ++detection_count;
    }
    json << "]}";

    std_msgs::msg::String message;
    message.data = json.str();
    publishers_[source_id]->publish(message);
    if (decorate_enabled_) {
      attach_camera_label(frame_meta, batch_meta, spec);
    }
    ++total_frames_[source_id];
    ++window_frames_[source_id];
    total_detections_[source_id] += detection_count;
    window_detections_[source_id] += detection_count;
  }

  static void decorate_object(
    NvDsObjectMeta & object_meta,
    const SourceSpec & spec,
    const char * class_name)
  {
    NvOSD_ColorParams color{0.2, 1.0, 0.2, 1.0};
    if (spec.name == "back") {
      color = NvOSD_ColorParams{0.1, 0.8, 1.0, 1.0};
    } else if (spec.name == "search") {
      color = NvOSD_ColorParams{1.0, 0.8, 0.1, 1.0};
    }

    object_meta.rect_params.border_width = 4U;
    object_meta.rect_params.border_color = color;
    object_meta.rect_params.has_bg_color = 0;

    NvOSD_TextParams & text = object_meta.text_params;
    if (text.display_text != nullptr) {
      g_free(text.display_text);
    }
    text.display_text = g_strdup_printf(
      "%s | %s %.2f", spec.name.c_str(), class_name, object_meta.confidence);
    text.x_offset = static_cast<int>(std::max(0.0F, object_meta.rect_params.left));
    text.y_offset = static_cast<int>(std::max(0.0F, object_meta.rect_params.top - 28.0F));
    text.font_params.font_name = const_cast<gchar *>("Sans");
    text.font_params.font_size = 18U;
    text.font_params.font_color = NvOSD_ColorParams{1.0, 1.0, 1.0, 1.0};
    text.set_bg_clr = 1;
    text.text_bg_clr = NvOSD_ColorParams{0.0, 0.0, 0.0, 0.75};
  }

  // Preview-only camera tag in the top-left corner of each tiled source.
  // display and record are mutually exclusive modes, so this decoration can
  // never appear inside the recorded MKV segments.
  static void attach_camera_label(
    const NvDsFrameMeta & frame_meta, NvDsBatchMeta & batch_meta, const SourceSpec & spec)
  {
    NvDsDisplayMeta * display_meta = nvds_acquire_display_meta_from_pool(&batch_meta);
    if (display_meta == nullptr) {
      return;
    }
    std::string label = spec.name;
    std::transform(
      label.begin(), label.end(), label.begin(),
      [](unsigned char character) {return static_cast<char>(std::toupper(character));});
    NvOSD_TextParams & text = display_meta->text_params[0];
    if (text.display_text != nullptr) {
      g_free(text.display_text);
    }
    text.display_text = g_strdup(label.c_str());
    text.x_offset = 8;
    text.y_offset = 18;
    text.font_params.font_name = const_cast<gchar *>("Sans");
    text.font_params.font_size = 13U;
    text.font_params.font_color = NvOSD_ColorParams{1.0, 1.0, 1.0, 1.0};
    text.set_bg_clr = 1;
    text.text_bg_clr = NvOSD_ColorParams{0.0, 0.0, 0.0, 0.65};
    display_meta->num_labels = 1;
    nvds_add_display_meta_to_frame(const_cast<NvDsFrameMeta *>(&frame_meta), display_meta);
  }

  void report_stats_if_due()
  {
    const auto current = std::chrono::steady_clock::now();
    const double elapsed = std::chrono::duration<double>(current - stats_start_).count();
    if (elapsed < 2.0) {
      return;
    }
    std::ostringstream report;
    report << std::fixed << std::setprecision(1) << "deepstream stats";
    for (std::size_t index = 0; index < active_source_count_; ++index) {
      report << ' ' << source_specs_[index].name << "_fps="
             << (static_cast<double>(window_frames_[index]) / elapsed);
    }
    report << " totals(";
    for (std::size_t index = 0; index < active_source_count_; ++index) {
      report << (index > 0U ? "," : "") << source_specs_[index].name;
    }
    report << ")=";
    for (std::size_t index = 0; index < active_source_count_; ++index) {
      report << (index > 0U ? "," : "") << total_frames_[index];
    }
    report << " detections(";
    for (std::size_t index = 0; index < active_source_count_; ++index) {
      report << (index > 0U ? "," : "") << source_specs_[index].name;
    }
    report << ")=";
    for (std::size_t index = 0; index < active_source_count_; ++index) {
      report << (index > 0U ? "," : "") << total_detections_[index];
    }
    RCLCPP_INFO(get_logger(), "%s", report.str().c_str());
    window_frames_.fill(0U);
    window_detections_.fill(0U);
    stats_start_ = current;
  }

  void poll_bus()
  {
    if (bus_ == nullptr) {
      return;
    }
    GstMessage * message = nullptr;
    while ((message = gst_bus_pop(bus_)) != nullptr) {
      switch (GST_MESSAGE_TYPE(message)) {
        case GST_MESSAGE_ERROR:
        {
          GError * error = nullptr;
          gchar * debug = nullptr;
          gst_message_parse_error(message, &error, &debug);
          RCLCPP_ERROR(
            get_logger(), "DeepStream error from %s: %s; %s",
            GST_OBJECT_NAME(message->src), error != nullptr ? error->message : "unknown",
            debug != nullptr ? debug : "no debug details");
          if (error != nullptr) {
            g_error_free(error);
          }
          g_free(debug);
          rclcpp::shutdown();
          break;
        }
        case GST_MESSAGE_WARNING:
        {
          GError * error = nullptr;
          gchar * debug = nullptr;
          gst_message_parse_warning(message, &error, &debug);
          RCLCPP_WARN(
            get_logger(), "DeepStream warning from %s: %s",
            GST_OBJECT_NAME(message->src), error != nullptr ? error->message : "unknown");
          if (error != nullptr) {
            g_error_free(error);
          }
          g_free(debug);
          break;
        }
        case GST_MESSAGE_EOS:
          RCLCPP_INFO(get_logger(), "DeepStream pipeline reached EOS");
          rclcpp::shutdown();
          break;
        default:
          break;
      }
      gst_message_unref(message);
    }
  }

