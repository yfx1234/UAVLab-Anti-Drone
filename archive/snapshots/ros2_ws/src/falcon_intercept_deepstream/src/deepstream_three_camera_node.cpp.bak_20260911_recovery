std::optional<std::string> json_object_for_key(
  const std::string & json, const std::string & key)
{
  const std::string marker = "\"" + key + "\"";
  const std::size_t key_pos = json.find(marker);
  if (key_pos == std::string::npos) {
    return std::nullopt;
  }
  const std::size_t object_start = json.find('{', key_pos + marker.size());
  if (object_start == std::string::npos) {
    return std::nullopt;
  }
  int depth = 0;
  bool in_string = false;
  bool escaped = false;
  for (std::size_t index = object_start; index < json.size(); ++index) {
    const char character = json[index];
    if (escaped) {
      escaped = false;
      continue;
    }
    if (character == '\\' && in_string) {
      escaped = true;
      continue;
    }
    if (character == '"') {
      in_string = !in_string;
      continue;
    }
    if (in_string) {
      continue;
    }
    if (character == '{') {
      ++depth;
    } else if (character == '}') {
      --depth;
      if (depth == 0) {
        return json.substr(object_start, index - object_start + 1U);
      }
    }
  }
  return std::nullopt;
}

std::optional<long long> json_integer_for_key(
  const std::string & json, const std::string & key)
{
  const std::regex pattern(
    "\\\"" + key + "\\\"\\s*:\\s*(-?[0-9]+)", std::regex::ECMAScript);
  std::smatch match;
  if (!std::regex_search(json, match, pattern)) {
    return std::nullopt;
  }
  try {
    return std::stoll(match[1].str());
  } catch (const std::exception &) {
    return std::nullopt;
  }
}

std::optional<bool> json_bool_for_key(const std::string & json, const std::string & key)
{
  const std::regex pattern(
    "\\\"" + key + "\\\"\\s*:\\s*(true|false)", std::regex::ECMAScript);
  std::smatch match;
  if (!std::regex_search(json, match, pattern)) {
    return std::nullopt;
  }
  return match[1].str() == "true";
}

std::optional<std::string> json_string_for_key(
  const std::string & json, const std::string & key)
{
  const std::regex pattern(
    "\\\"" + key + "\\\"\\s*:\\s*\\\"([^\\\"]*)\\\"", std::regex::ECMAScript);
  std::smatch match;
  if (!std::regex_search(json, match, pattern)) {
    return std::nullopt;
  }
  return match[1].str();
}

std::optional<RoiRect> parse_roi_rect(
  const std::string & roi_json, unsigned int image_width, unsigned int image_height,
  unsigned int minimum_size)
{
  const auto raw_x1 = json_integer_for_key(roi_json, "x1");
  const auto raw_y1 = json_integer_for_key(roi_json, "y1");
  const auto raw_x2 = json_integer_for_key(roi_json, "x2");
  const auto raw_y2 = json_integer_for_key(roi_json, "y2");
  if (!raw_x1 || !raw_y1 || !raw_x2 || !raw_y2) {
    return std::nullopt;
  }

  auto clamp_int = [](long long value, unsigned int limit) {
      return static_cast<unsigned int>(std::max<long long>(0, std::min<long long>(value, limit)));
    };
  unsigned int x1 = clamp_int(*raw_x1, image_width);
  unsigned int y1 = clamp_int(*raw_y1, image_height);
  unsigned int x2 = clamp_int(*raw_x2, image_width);
  unsigned int y2 = clamp_int(*raw_y2, image_height);

  // NV12 crop coordinates and extents must be even. Expand outward while staying in bounds.
  x1 &= ~1U;
  y1 &= ~1U;
  x2 = std::min(image_width, (x2 + 1U) & ~1U);
  y2 = std::min(image_height, (y2 + 1U) & ~1U);
  if (x2 <= x1 || y2 <= y1 || x2 - x1 < minimum_size || y2 - y1 < minimum_size) {
    return std::nullopt;
  }
  return RoiRect{x1, y1, x2, y2};
}

