std::string quote_gstreamer(const std::string & value)
{
  std::string escaped;
  escaped.reserve(value.size() + 2);
  escaped.push_back('"');
  for (const char character : value) {
    if (character == '\\' || character == '"') {
      escaped.push_back('\\');
    }
    escaped.push_back(character);
  }
  escaped.push_back('"');
  return escaped;
}

double clamp_value(double value, double lower, double upper)
{
  return std::max(lower, std::min(value, upper));
}

FalconColorMatrix parse_color_matrix(
  const std::vector<double> & values, const std::string & parameter_name)
{
  if (values.size() != 9U) {
    throw std::runtime_error(parameter_name + " must contain exactly 9 row-major values");
  }
  FalconColorMatrix matrix;
  for (std::size_t index = 0; index < 9U; ++index) {
    matrix.values[index] = static_cast<float>(values[index]);
  }
  return matrix;
}

