            self._terminal_ttc_s = number("terminal_ttc_s")
            self._contact_range_m = number("contact_range_m")
            self._contact_ttc_s = number("contact_ttc_s")
            self._contact_bbox_fraction = number("contact_bbox_fraction")
            self._minimum_expansion_rate_s = number("minimum_expansion_rate_s")
            self._contact_acceleration_mps2 = number("contact_acceleration_mps2")
            self._contact_speed_drop_mps = number("contact_speed_drop_mps")
            self._contact_loss_confirm_delay_s = number("contact_loss_confirm_delay_s")
