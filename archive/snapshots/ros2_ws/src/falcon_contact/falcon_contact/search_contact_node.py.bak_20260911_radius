                # 0.16m @ 10m -> 约 38px。旧值 55.0 对应 23x23cm 靶，直接沿用
                # 会让单目距离整体虚高 23/16 ≈ 1.44 倍，接触窗口推迟开门。
                "reference_bbox_px": 38.0,
                "reference_image_width": 2560.0,
                "range_filter_tau_s": 0.30,
                "rate_filter_tau_s": 0.20,
                "expansion_filter_tau_s": 0.25,
                "prediction_control_delay_s": 0.08,
                "prediction_guidance_lead_s": 0.12,
                "prediction_maximum_horizon_s": 0.45,
                "prediction_maximum_rate_rad_s": 0.70,
                "prediction_maximum_offset_rad": 0.12,
                # 有界线性提前量（打 0-2 m/s 慢速移动软靶）：按目标线速度
                # 把瞄准点前移，弥补图像延迟 x 目标速度的位移；静止靶在
                # 死区内自动退化为原视线。
                "lead_pursuit_enabled": True,
                "lead_maximum_target_speed_mps": 2.5,
                "lead_maximum_distance_m": 1.0,
                "lead_maximum_time_s": 1.0,
                "lead_deadband_mps": 0.25,
                # 接触窗口内的"目标丢失"判定：同帧配对超过该时长未更新即算
