            self._prediction_guidance_lead_s = min(0.20, max(0.0, number("prediction_guidance_lead_s")))
            self._prediction_maximum_horizon_s = min(0.60, max(0.0, number("prediction_maximum_horizon_s")))
            self._prediction_maximum_rate_rad_s = min(1.0, max(0.0, number("prediction_maximum_rate_rad_s")))
            self._prediction_maximum_offset_rad = min(0.20, max(0.0, number("prediction_maximum_offset_rad")))
            self._lead_pursuit_enabled = bool(self.get_parameter("lead_pursuit_enabled").value)
            self._lead_maximum_target_speed_mps = max(0.0, number("lead_maximum_target_speed_mps"))
            self._lead_maximum_distance_m = max(0.0, number("lead_maximum_distance_m"))
            self._lead_maximum_time_s = max(0.0, number("lead_maximum_time_s"))
            self._lead_deadband_mps = max(0.0, number("lead_deadband_mps"))
            self._last_lead: dict = {}
            self._contact_loss_stale_s = min(
                0.45, max(0.05, number("contact_loss_stale_s"))
            )
            self._phase_downgrade_hold_s = max(0.0, number("phase_downgrade_hold_s"))
            self._settle_speed_mps = max(0.0, number("settle_speed_mps"))
            self._brake_max_hold_s = max(0.1, number("brake_max_hold_s"))
            self._retreat_max_duration_s = max(0.1, number("retreat_max_duration_s"))
            self._contact_lost_since_s: float | None = None
            self._downgrade_since_s: float | None = None
            # 冲刺版硬上限：参数无论配多少都不会突破。默认值与接触段速度
            # 保持一致关系（总限幅 >= 接触速度），launch 可覆盖。
            self._approach_speed_mps = min(2.0, max(0.0, number("approach_speed_mps")))
            self._terminal_speed_mps = min(3.0, max(0.0, number("terminal_speed_mps")))
            self._contact_speed_mps = min(4.5, max(0.0, number("contact_speed_mps")))
