"""单搜索相机软靶直接接触节点。

节点只发布速度轨迹设定值，不发布解锁、上锁或模式切换命令。控制输出仍需经过
原有 upstream_gate_node 与 px4_upstream_adapter_node 的安全门。
"""

from __future__ import annotations

import json
import math
from collections import deque
from dataclasses import dataclass

from .contact_logic import (
    apply_lens_tilt,
    guidance_phase,
    lead_pursuit_direction,
    limit_velocity_ned,
    los_body_frd,
    low_pass,
    predict_world_line_of_sight,
    quaternion_to_rotation_matrix,
    range_from_bbox_fraction,
    rotate_vector,
    slerp_quaternion,
    time_to_contact_s,
    unit_fru_from_angles,
    validate_speed_profile,
    vector_to_azimuth_elevation,
    wrap_pi,
)


@dataclass(frozen=True)
class DetectionFrame:
    key: tuple[str, int]
    stamp_s: float
    sequence: int
    confidence: float
    bbox_fraction: float


@dataclass(frozen=True)
class BearingFrame:
    key: tuple[str, int]
    stamp_s: float
    sequence: int
    confidence: float
    horizontal_rad: float
    vertical_rad: float


def frame_key(sequence: int, stamp_s: float) -> tuple[str, int]:
    if int(sequence) != 0:
        return "sequence", int(sequence)
    return "millisecond", int(round(float(stamp_s) * 1000.0))


def parse_detection_frame(text: str, minimum_confidence: float) -> DetectionFrame | None:
    try:
        payload = json.loads(str(text))
        stamp_data = payload.get("header", {}).get("stamp", {})
        stamp_s = float(stamp_data["sec"]) + float(stamp_data.get("nanosec", 0)) / 1.0e9
        sequence = int(payload.get("sequence", 0))
        width = float(payload.get("image_width", 2560.0))
        height = float(payload.get("image_height", 1440.0))
    except (KeyError, TypeError, ValueError):
        return None
    if not math.isfinite(stamp_s) or stamp_s <= 0.0 or width <= 0.0 or height <= 0.0:
        return None
    best = None
    for item in payload.get("detections", []):
        try:
            confidence = float(item.get("confidence", 0.0))
            bbox = tuple(float(value) for value in item["bbox_xyxy"][:4])
        except (KeyError, TypeError, ValueError):
            continue
        if len(bbox) != 4 or confidence < float(minimum_confidence):
            continue
        if best is None or confidence > best[0]:
            best = confidence, bbox
    if best is None:
        return None
    confidence, (x1, y1, x2, y2) = best
    # Keep the existing field calibration contract: the larger bbox side is
    # expressed as a fraction of image width, regardless of box orientation.
    bbox_fraction = max(abs(x2 - x1), abs(y2 - y1)) / width
    if not math.isfinite(bbox_fraction) or bbox_fraction <= 0.0 or bbox_fraction > 1.5:
        return None
    return DetectionFrame(
        key=frame_key(sequence, stamp_s),
        stamp_s=stamp_s,
        sequence=sequence,
        confidence=confidence,
        bbox_fraction=bbox_fraction,
    )


def main(args=None) -> int:
    import rclpy
    from anti_drone_interfaces.msg import SearchObservation
    from px4_msgs.msg import OffboardControlMode, TrajectorySetpoint, VehicleAttitude, VehicleLocalPosition
    from rclpy.executors import ExternalShutdownException
    from rclpy.node import Node
    from rclpy.qos import (
        DurabilityPolicy,
        HistoryPolicy,
        QoSProfile,
        ReliabilityPolicy,
        qos_profile_sensor_data,
    )
    from std_msgs.msg import Bool, String

    class SearchContactNode(Node):
        def __init__(self) -> None:
            super().__init__("search_contact_node")
            defaults = {
                "rate_hz": 30.0,
                "contact_enabled": False,
                "minimum_confidence": 0.55,
                "required_lock_samples": 8,
                "lock_max_gap_s": 0.25,
                "lock_max_bearing_jump_rad": 0.20,
                "lock_max_scale_ratio": 1.8,
                "pair_stamp_tolerance_s": 0.02,
                "capture_timeout_s": 0.45,
                "attitude_timeout_s": 0.25,
                "local_position_timeout_s": 0.50,
                "history_duration_s": 2.0,
                "history_edge_tolerance_s": 0.08,
                "lens_tilt_rad": 0.1745,
                "reference_range_m": 10.0,
                # 2026-09 靶标改为 13x16 cm 气球（长边 16 cm）。按 2026-09-06
