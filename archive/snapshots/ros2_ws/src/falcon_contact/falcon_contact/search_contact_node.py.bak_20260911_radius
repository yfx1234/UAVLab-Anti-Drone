            self._local_timeout_s = number("local_position_timeout_s")
            self._history_duration_s = number("history_duration_s")
            self._history_edge_tolerance_s = number("history_edge_tolerance_s")
            self._lens_tilt_rad = number("lens_tilt_rad")
            self._reference_range_m = number("reference_range_m")
            self._reference_bbox_px = number("reference_bbox_px")
            self._reference_image_width = number("reference_image_width")
            self._range_filter_tau_s = number("range_filter_tau_s")
