# 网枪实物击发链路（用户级 systemd，2026-10-23）：deploy/netgun_pwm_link.py serve
# 经 MAVProxy（qgc-mavlink-forward.service 的 --out=udp:127.0.0.1:14555）与飞控通信，
# 受理拦截链 trigger_command 的击发请求（~/netgun_logs/netgun_pwm.sock）。
# 安装/更新：bash ~/interceptor_ws/deploy/install_netgun_pwm_link.sh
# 击发值/安全值/保持时间改 ExecStart 参数后重跑安装脚本（安全值 none = 不复位）。
[Unit]
Description=Netgun PWM trigger link (MAVLink via MAVProxy -> PX4 FMU PWM OUT 5)
After=qgc-mavlink-forward.service
Wants=qgc-mavlink-forward.service
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u %h/interceptor_ws/deploy/netgun_pwm_link.py serve --fire-value -1 --safe-value 1 --hold-s 1.0
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=default.target
