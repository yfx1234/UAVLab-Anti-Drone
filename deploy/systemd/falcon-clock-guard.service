[Unit]
Description=Restore and persist a trustworthy lower-bound Jetson wall clock
Documentation=file:/home/uavlab/Jetson_ROS2_V0/deploy/FALCON_CLOCK_GUARD.md
DefaultDependencies=no
RequiresMountsFor=/var/lib/falcon-clock
After=systemd-remount-fs.service
Before=systemd-timesyncd.service time-set.target sysinit.target shutdown.target
Conflicts=shutdown.target
Wants=time-set.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/falcon-clock-guard restore
ExecStop=/usr/local/sbin/falcon-clock-guard save
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
