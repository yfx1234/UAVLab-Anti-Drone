	fragment-damiao-reset@100 {
		target-path = "/bus@0/gpio@2200000";

		__overlay__ {

			zed-cam0-reset {
				gpio-hog;
				gpios = <0x3e 0x00>;
				output-high;
				line-name = "zed-cam0-reset";
			};
		};
	};

	fragment-disable-imx219@101 {
		target-path = "/";

		__overlay__ {

			bus@0 {

				cam_i2cmux {

					i2c@0 {

						rbpcv2_imx219_a@10 {
							status = "disabled";
						};
					};

					i2c@1 {

						rbpcv2_imx219_c@10 {
							status = "disabled";
						};
					};
				};
			};
		};
	};
};
