							sync_sensor = "ZED_CAM0";
							sync_sensor_index = <0x01>;
							physical_w = "15.0";
							physical_h = "12.5";
							post_crop_frame_drop = "0";
							use_sensor_mode_id = "true";
							compatible = "stereolabs,zedx";
							reg = <0x28>;
							clocks = <0xffffffff 0x24 0xffffffff 0x24>;
							clock-names = "extperiph1\0pllp_grtba";
							mclk = "extperiph1";
							zedx-id = "0";
							channel = "a";
							has-eeprom;
							eeprom-addr = <0x54>;
